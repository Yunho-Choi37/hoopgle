{
    "hosting": {
        "site": "hoopgle-hoopdex",
        "public": "build",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "redirects": [
            {
                "source": "**",
                "destination": "https://hoopgle.vercel.app",
                "type": 301
            }
        ]
    }
}